generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseType {
  EMPLOYEE
  MATERIAL
  FUEL
  TRANSPORT
  EQUIPMENT
  SERVICE
  OTHER
}

enum BudgetAdjustmentType {
  INCREASE
  DECREASE
}

enum ProjectMemberRole {
  EDITOR
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  FROZEN
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  telegramUserId String?  @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  role          UserRole  @default(MEMBER)
  approvalStatus UserApprovalStatus @default(PENDING)
  approvalNote  String?   @db.Text
  approvedAt    DateTime?
  sessions      Session[]
  projects      Project[]
  projectMemberships ProjectMember[]
  createdTasks     Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  userId          String
  status          ProjectStatus @default(ACTIVE)
  frozenAt        DateTime?
  completedAt     DateTime?
  title           String
  description     String?   @db.Text
  ownerName       String?
  ownerPhone      String?
  ownerEmail      String?
  ownerNotes      String?   @db.Text
  estimatedAmount BigInt    @default(0)
  receivedAmount  BigInt    @default(0)
  spentAmount     BigInt    @default(0)
  deletedAt       DateTime?
  clientRequestId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  payments        Payment[]
  budgetAdjustments BudgetAdjustment[]
  members         ProjectMember[]
  tasks           Task[]

  @@index([userId, createdAt])
  @@index([userId, status, updatedAt])
  @@index([deletedAt])
}

model Expense {
  id           String      @id @default(cuid())
  projectId    String
  type         ExpenseType
  title        String
  description  String?     @db.Text
  amount       BigInt
  date         DateTime
  employeeName String?
  vendorName   String?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  clientRequestId String?  @unique
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@index([projectId, deletedAt, date])
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  amount    BigInt
  date      DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  clientRequestId String? @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@index([projectId, deletedAt, date])
}

model BudgetAdjustment {
  id        String               @id @default(cuid())
  projectId String
  type      BudgetAdjustmentType
  amount    BigInt
  date      DateTime
  notes     String?              @db.Text
  createdAt DateTime             @default(now())
  clientRequestId String?        @unique
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

// Append-only operational evidence. It intentionally has no foreign keys so
// future cleanup cannot erase the history required to reconstruct an action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  projectId  String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())
  deletedAt DateTime?
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId, deletedAt])
}

model Task {
  id           String     @id @default(cuid())
  createdById  String
  projectId    String?
  title        String
  description  String?    @db.Text
  status       TaskStatus @default(TODO)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdById, status, updatedAt])
  @@index([projectId, status])
  @@index([createdById, deletedAt, status, updatedAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}
