# Local PostgreSQL connection. Copy this file to .env before starting the app.
# Use port 5433 when connecting from the host; Docker Compose maps db:5432 -> localhost:5433.
DATABASE_URL="postgresql://shinex:shinex_dev_password@localhost:5433/shinex_crm?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-before-production"
# Google OAuth application credentials. Add http://localhost:3000/api/auth/callback/google
# to the Authorized redirect URIs in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Required when accessing the dev server through a tunnel (e.g. ngrok).
AUTH_TRUST_HOST="true"
# Optional: set to your public tunnel URL for Auth.js callbacks.
# AUTH_URL="https://your-subdomain.ngrok.app"
