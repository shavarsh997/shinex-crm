# Local PostgreSQL connection. Copy this file to .env before starting the app.
# Use port 5433 when connecting from the host; Docker Compose maps db:5432 -> localhost:5433.
DATABASE_URL="postgresql://shinex:shinex_dev_password@localhost:5433/shinex_crm?schema=public"
# Production: copy this file to .env.production, use a managed PostgreSQL URL
# with a unique strong password, and optionally set APP_PORT (default: 3000).
APP_PORT="3000"
# A newly registered account with this email is approved immediately and gets
# the ADMIN role. Leave empty to disable automatic administrator registration.
ADMIN_EMAIL=""
# Optional values for `npm run db:seed`. If omitted, the seed uses
# admin@shinex.local and ChangeMe123! (development use only).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Bot token from @BotFather. Never expose this value to the browser.
TELEGRAM_BOT_TOKEN=""
# Public HTTPS origin of the production CRM only. Set this on the Production
# environment, never on Vercel Preview. The app registers
# https://<this-domain>/api/telegram/webhook after the first production request.
TELEGRAM_WEB_APP_URL=""
# A random 32–256-character secret (A-Z, a-z, 0-9, _ and - only) that guards
# incoming Telegram webhook calls. Use a different value for each environment.
TELEGRAM_WEBHOOK_SECRET=""
# No authentication secret is required. The app creates one opaque session token
# at login, stores only its hash in PostgreSQL, and expires it after 37 days.
