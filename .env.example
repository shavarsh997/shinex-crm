# Local PostgreSQL connection. Copy this file to .env before starting the app.
# Use port 5433 when connecting from the host; Docker Compose maps db:5432 -> localhost:5433.
DATABASE_URL="postgresql://shinex:shinex_dev_password@localhost:5433/shinex_crm?schema=public"
# A newly registered account with this email is approved immediately and gets
# the ADMIN role. Leave empty to disable automatic administrator registration.
ADMIN_EMAIL=""
# Bot token from @BotFather. Required only for Telegram Mini App linking and
# payout notifications; never expose this value to the browser.
TELEGRAM_BOT_TOKEN=""
# No authentication secret is required. The app creates one opaque session token
# at login, stores only its hash in PostgreSQL, and expires it after 37 days.
