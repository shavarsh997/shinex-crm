# Local PostgreSQL connection. Copy this file to .env before starting the app.
# Use port 5433 when connecting from the host; Docker Compose maps db:5432 -> localhost:5433.
DATABASE_URL="postgresql://shinex:shinex_dev_password@localhost:5433/shinex_crm?schema=public"
# Required by Auth.js to sign and encrypt sessions. Generate a unique value
# before deployment, for example with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-before-production"

# Development accounts created by `npm run db:seed`. Change these values for
# any shared or deployed environment before seeding.
SEED_ADMIN_NAME="Администратор Shinex"
SEED_ADMIN_EMAIL="admin@shinex.local"
SEED_ADMIN_PASSWORD="AdminPass!2026"
SEED_USER_NAME="Сотрудник Shinex"
SEED_USER_EMAIL="user@shinex.local"
SEED_USER_PASSWORD="UserPass!2026"
