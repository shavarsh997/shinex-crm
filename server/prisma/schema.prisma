generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseType {
  EMPLOYEE
  MATERIAL
  FUEL
  TRANSPORT
  EQUIPMENT
  SERVICE
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  role          UserRole  @default(MEMBER)
  approvalStatus UserApprovalStatus @default(PENDING)
  approvalNote  String?   @db.Text
  approvedAt    DateTime?
  sessions      Session[]
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?   @db.Text
  ownerName       String?
  ownerPhone      String?
  ownerEmail      String?
  ownerNotes      String?   @db.Text
  estimatedAmount BigInt    @default(0)
  receivedAmount  BigInt    @default(0)
  spentAmount     BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  payments        Payment[]

  @@index([userId, createdAt])
}

model Expense {
  id           String      @id @default(cuid())
  projectId    String
  type         ExpenseType
  title        String
  description  String?     @db.Text
  amount       BigInt
  date         DateTime
  employeeName String?
  vendorName   String?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model Payment {
  id        String   @id @default(cuid())
  projectId String
  amount    BigInt
  date      DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}
